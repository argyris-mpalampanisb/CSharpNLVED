<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- App version. CI overrides this from the git tag (v0.2.0 -> 0.2.0). -->
    <Version>0.1.0</Version>
    <Product>CSharpNLVED</Product>
    <Company>CSharpNLVED contributors</Company>
    <Copyright>Copyright (C) 2026 CSharpNLVED contributors. Licensed under GPLv3.</Copyright>

    <!-- Portable app: no satellite resource folders cluttering the output. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
