<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CSharpNLVED.App"
             x:Class="CSharpNLVED.App.TextPanel">
  <!-- Shown in the preview area while one text clip is selected.
       Left: how the text will look. Right: its settings. Every change applies right away. -->
  <Grid ColumnDefinitions="*,340">
    <local:TextPreviewControl x:Name="Preview" Grid.Column="0" />

    <Border Grid.Column="1" Background="#1B1D23" Padding="12,10">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,0,8,0">
          <TextBlock Text="Text clip" FontWeight="SemiBold" />

          <TextBox x:Name="TextEntry" AcceptsReturn="True" TextWrapping="Wrap" Height="58" FontSize="14"
                   ToolTip.Tip="What the clip says. Enter starts a new line." />

          <Grid ColumnDefinitions="64,*">
            <TextBlock Text="Font" VerticalAlignment="Center" />
            <ComboBox x:Name="FontBox" Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
          </Grid>
          <TextBlock x:Name="FontWarning" IsVisible="False" Foreground="#FFB347" FontSize="12" TextWrapping="Wrap"
                     Text="This font's file wasn't found, so it can't be used for export. Pick another font." />

          <Grid ColumnDefinitions="64,*,64,*">
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <NumericUpDown x:Name="SizeBox" Grid.Column="1" Minimum="4" Maximum="1000" Increment="4"
                           FormatString="0" Margin="0,0,8,0"
                           ToolTip.Tip="Text height in pixels of a 1080p frame; scaled to the export size." />
            <TextBlock Grid.Column="2" Text="Outline" VerticalAlignment="Center" Margin="4,0,0,0" />
            <NumericUpDown x:Name="OutlineBox" Grid.Column="3" Minimum="0" Maximum="50" Increment="1"
                           FormatString="0" ToolTip.Tip="Outline thickness (0 = none)." />
          </Grid>

          <TextBlock Text="Text colour" Foreground="#8A8F98" FontSize="12" />
          <Grid ColumnDefinitions="*,96">
            <WrapPanel x:Name="TextSwatches" />
            <TextBox x:Name="TextColorBox" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                     ToolTip.Tip="#RRGGBB, or #RRGGBBAA for see-through (AA: 00 = invisible, FF = solid)." />
          </Grid>

          <TextBlock Text="Outline colour" Foreground="#8A8F98" FontSize="12" />
          <Grid ColumnDefinitions="*,96">
            <WrapPanel x:Name="OutlineSwatches" />
            <TextBox x:Name="OutlineColorBox" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                     ToolTip.Tip="#RRGGBB, or #RRGGBBAA for see-through." />
          </Grid>

          <TextBlock Text="Position" Foreground="#8A8F98" FontSize="12" />
          <Grid ColumnDefinitions="Auto,*" >
            <Grid x:Name="PositionGrid" ColumnDefinitions="30,30,30" RowDefinitions="22,22,22" Margin="0,0,12,0" />
            <Grid Grid.Column="1" ColumnDefinitions="18,*,40" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
              <TextBlock Text="X" VerticalAlignment="Center" />
              <Slider x:Name="XSlider" Grid.Column="1" Minimum="0" Maximum="100" />
              <TextBlock x:Name="XLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
              <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center" />
              <Slider x:Name="YSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" />
              <TextBlock x:Name="YLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
            </Grid>
          </Grid>

          <TextBlock Foreground="#6C717A" FontSize="11" TextWrapping="Wrap"
                     Text="Fades: drag the clip's top corners on the timeline. Ctrl+Z undoes changes." />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
