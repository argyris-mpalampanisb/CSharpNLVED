<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CSharpNLVED.Core.Tests</RootNamespace>

    <!-- .NET 10+ SDKs run tests with Microsoft.Testing.Platform (opted in via global.json). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned so a new xUnit release can't break CI on its own. -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpNLVED.Core\CSharpNLVED.Core.csproj" />
  </ItemGroup>
</Project>
